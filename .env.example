# ============================================================
# Docker Compose 部署（服务器）需要以下变量
# ============================================================

# compose 项目名（决定容器/网络/卷前缀，固定它可避免目录改名导致命名空间变化）
COMPOSE_PROJECT_NAME=azmark

# 数据库密码（compose 用它创建 postgres，并拼装 api 的 DATABASE_URL）
# 必须只用 URL 安全字符（字母/数字），推荐用 hex，例：openssl rand -hex 24
# 不要用 @ : / # ? $ 等特殊字符，否则会破坏 DATABASE_URL 解析。
POSTGRES_PASSWORD=change-me

# JWT / IP 哈希用的密钥，至少 32 字节；生成：openssl rand -hex 32
SECRET_KEY=change-me-in-production

# 宿主机暴露端口（与别的服务冲突时改这里，无需改 compose 文件）
WEB_PORT=3000
API_PORT=8000

# 允许跨域访问 API 的前端地址（逗号分隔可多个）；须与 WEB_PORT 一致
CORS_ORIGINS=http://localhost:3000

# 前端构建期注入的 API 公开地址（浏览器访问用）；须与 API_PORT 一致
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================================
# 仅“本地非 Docker 直连后端”时才需要（Docker 部署可忽略）
# ============================================================
# DATABASE_URL=postgresql+psycopg://azmark:azmark@localhost:5432/azmark
# REDIS_URL=redis://localhost:6379/0
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
