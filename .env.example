# ============================================================
# Docker Compose 部署（服务器）需要以下变量
# ============================================================

# compose 项目名（决定容器/网络/卷前缀，固定它可避免目录改名导致命名空间变化）
COMPOSE_PROJECT_NAME=azmark

# 数据库密码（compose 用它创建 postgres，并拼装 api 的 DATABASE_URL）
# 必须只用 URL 安全字符（字母/数字），推荐用 hex，例：openssl rand -hex 24
# 不要用 @ : / # ? $ 等特殊字符，否则会破坏 DATABASE_URL 解析。
POSTGRES_PASSWORD=change-me

# JWT / IP 哈希用的密钥，至少 32 字节；生成：openssl rand -hex 32
SECRET_KEY=change-me-in-production

# 首个管理员（可选，spec #78）：仅在库中还没有可用管理员时于启动时创建。
# 不设置也可以在服务器上运行：
#   docker compose exec -T api python -m app create-admin --username admin --email you@example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong-password

# 对象存储（附件）：compose 内置 MinIO，默认只在内网可达，bucket 首次上传时自动创建。
# 生产环境请务必修改 S3_SECRET_KEY（至少 8 位）。外部 S3 / R2 / OSS 也可用：
# 设置 S3_ENDPOINT/S3_REGION/S3_USE_SSL/S3_ADDRESSING_STYLE，并确保 bucket 已创建。
# MinIO 开源版已归档，compose 默认使用 1panel 镜像代理的最后一个开源版本。
# 如服务器可直连 Docker Hub，可覆盖为：minio/minio:RELEASE.2025-09-07T16-13-09Z
# MINIO_IMAGE=docker.1panel.live/minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
# Docker 构建 PyPI 镜像；服务器访问官方源慢时使用默认值，可改为其他镜像。
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

S3_ACCESS_KEY=azmark
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=azmark
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_USE_SSL=true
# S3_ADDRESSING_STYLE=path
# MAX_ATTACHMENT_BYTES=20971520

# 宿主机暴露端口（只有 web 对外；与别的服务冲突时改这里即可）
WEB_PORT=3000

# 浏览器访问 web 的地址（同源代理，不需要单独的 API 地址）；须与 WEB_PORT 一致
CORS_ORIGINS=http://localhost:3000

# ============================================================
# 仅“本地非 Docker 直连后端”时才需要（Docker 部署可忽略）
# ============================================================
# DATABASE_URL=postgresql+psycopg://azmark:azmark@localhost:5432/azmark
# REDIS_URL=redis://localhost:6379/0
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
