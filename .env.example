# ============================================================
# Docker Compose 部署（服务器）需要以下变量
# ============================================================

# 数据库密码（compose 用它创建 postgres，并拼装 api 的 DATABASE_URL）
POSTGRES_PASSWORD=change-me

# JWT / IP 哈希用的密钥，至少 32 字节；生成：openssl rand -hex 32
SECRET_KEY=change-me-in-production

# 允许跨域访问 API 的前端地址（逗号分隔可多个）
CORS_ORIGINS=http://localhost:3000

# 前端构建期注入的 API 公开地址（浏览器访问用）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================================
# 仅“本地非 Docker 直连后端”时才需要（Docker 部署可忽略）
# ============================================================
# DATABASE_URL=postgresql+psycopg://azmark:azmark@localhost:5432/azmark
# REDIS_URL=redis://localhost:6379/0
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
