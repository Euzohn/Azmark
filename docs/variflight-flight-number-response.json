    "_note": "Raw VariFlight field → normalized field. Aliases are tried case-insensitively; first non-empty value wins.",
    "FlightNo / FlightNumber / fnum": "flight_number (also selects the requested flight)",
    "FlightCompanyCode / AirlineCode / CarrierCode": "airline_code (fallback: 2-char IATA prefix of flight_number)",
    "FlightCompanyEn / AirlineNameEn / CompanyEn / AirlineEn": "airline_name (English)",
    "FlightCompany / AirlineName / Company (non-ASCII)": "airline_name_zh (Chinese)",
    "FlightCompany / AirlineName / Company (ASCII)": "airline_name (English fallback)",
    "FlightDepcode / DepAirportCode / DepCode / OriginCode": "origin_iata",
    "FlightArrcode / ArrAirportCode / ArrCode / DestCode": "destination_iata",
    "FlightDepAirport / FlightArrAirport": "origin_name / destination_name — intentionally None (Chinese-only; local reference fills names)",
    "FlightDeptimePlanDate / FlightDeptimePlan / DepTimePlan": "departure_time (scheduled)",
    "FlightArrtimePlanDate / FlightArrtimePlan / ArrTimePlan": "arrival_time (scheduled)",
    "FlightDeptimeDate / FlightDeptimeActual / DepTimeActual / FlightDeptimeReadyDate": "actual_departure_time",
    "FlightArrtimeDate / FlightArrtimeActual / ArrTimeActual / FlightArrtimeReadyDate": "actual_arrival_time",
    "FlightHTerminal / FlightDepTerminal / DepTerminal": "departure_terminal",
    "BoardGate / FlightDepGate / DepGate / Gate": "departure_gate",
    "FlightTerminal / FlightArrTerminal / ArrTerminal": "arrival_terminal",
    "FlightArrGate / ArrGate / ArrivalGate": "arrival_gate",
    "CheckinTable / CheckinCounter / CheckInDesk / CheckinDesk": "check_in_desk",
    "BaggageID / BaggageCarousel / BaggageReclaim / BaggageBelt / ArrBaggage / LuggageCarousel": "baggage_belt",
    "generic / AircraftModel / PlaneType / ftype / FlightType / AircraftType": "aircraft_model (first non-empty; `generic` preferred)",
    "AircraftNumber / AircraftReg / FlightReg / RegisterNo / ACReg / TailNo": "aircraft_reg",
    "FlightState / FlightStatus / State / Status": "status (scheduled / completed / cancelled)",
    "distance / FlightDistance / Distance / DistanceKm": "distance (km)",
    "org_timezone / OrgTimezone / dep_timezone": "departure_timezone (offset seconds → ±HH:MM)",
    "dst_timezone / DstTimezone / arr_timezone": "arrival_timezone (offset seconds → ±HH:MM)"
  },
