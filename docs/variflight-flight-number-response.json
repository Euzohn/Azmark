  "field_catalog": {
    "FlightNo": "string — flight number, e.g. 'MU5101'",
    "FlightCompany": "string — airline name; usually Chinese (e.g. '金鹏航空'), occasionally ASCII",
    "FlightCompanyEn": "string? — English airline alias when present",
    "FlightCompanyCode": "string? — IATA airline code when present",
    "FlightDepcode": "string — departure IATA airport code",
    "FlightArrcode": "string — arrival IATA airport code",
    "FlightDepAirport": "string — departure airport short name (Chinese)",
    "FlightArrAirport": "string — arrival airport short name (Chinese)",
    "FlightDeptimePlanDate": "string — scheduled departure, local wall clock 'YYYY-MM-DD HH:MM:SS'",
    "FlightArrtimePlanDate": "string — scheduled arrival, local wall clock",
    "FlightDeptimeReadyDate": "string — estimated departure, local wall clock (may be '')",
    "FlightArrtimeReadyDate": "string — estimated arrival, local wall clock (may be '')",
    "FlightDeptimeDate": "string — actual departure, local wall clock (may be '')",
    "FlightArrtimeDate": "string — actual arrival, local wall clock (may be '')",
    "FlightHTerminal": "string — departure terminal",
    "FlightTerminal": "string — arrival terminal",
    "BoardGate": "string — boarding/departure gate",
    "FlightArrGate": "string? — arrival gate",
    "CheckinTable": "string — check-in counters, e.g. 'C03-D07'",
    "BaggageID": "string — baggage belt, e.g. '13' (may be '')",
    "ftype": "string — IATA aircraft type, e.g. 'B77W'",
    "generic": "string — full aircraft model, e.g. 'Boeing 777-39P'",
    "AircraftNumber": "string — tail registration, e.g. 'B7881'",
    "FlightState": "string — Chinese status: 计划 / 起飞 / 到达 / 取消 …",
    "distance": "string — route distance in km (lowercase key)",
    "org_timezone": "string — departure UTC offset in seconds, e.g. '28800' (+08:00)",
    "dst_timezone": "string — arrival UTC offset in seconds, e.g. '28800' (+08:00)",
    "StopFlag": "string — stopover flag, e.g. '0'",
    "alternate_info": "array — alternate-airport info",
    "FillFlightInfo": "object|null — supplementary info"
  },
  "time_formats": {
    "note": "Times are local wall-clock with no offset. The UTC offset is shipped separately in org_timezone / dst_timezone (seconds).",
    "PlanDate": "scheduled time",
    "ReadyDate": "estimated time",
    "Date": "actual time",
    "timezone": "28800 → +08:00; -18000 → -05:00"
  },
  "notes": [
    "flight_enrichment._merge keeps the local English airline name for en-US and uses VariFlight's Chinese FlightCompany for airline_name_zh.",
    "When VariFlight returns an ASCII FlightCompany and no FlightCompanyEn, airline_name is taken from it directly.",
    "Empty strings are treated as absent (the parser returns None).",
    "origin_name / destination_name are left None on purpose so the en-US UI never shows Chinese-only airport names.",
    "A 404 or an empty data array means 'no such flight'; the enrichment layer then falls back to the local prefix result."
  ]
}
