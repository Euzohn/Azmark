{
  "_source": "AeroDataBox RapidAPI — GET /flights/number/{number}/{date}",
  "_endpoint": "https://aerodatabox.p.rapidapi.com/flights/number/{flightNumber}/{YYYY-MM-DD}",
  "_auth": "Headers: X-RapidAPI-Key, X-RapidAPI-Host",
  "_params": "withAircraftImage, withTracking, withCrew, withFlightNumberOffset (all false)",
  "_response_shape": "Top-level JSON array (NOT {flights: [...]})",
  "_captured": "2026-10-09",
  "_azmark_mapping": {
    "_note": "Which raw fields the backend extracts into TransportRecord / FlightLookupResult",
    "airline.iata": "airline_code",
    "airline.name": "carrier (display fallback)",
    "departure.airport.iata": "origin",
    "arrival.airport.iata": "destination",
    "departure.airport.name": "origin_name (lookup only)",
    "arrival.airport.name": "destination_name (lookup only)",
    "departure.scheduledTime.local": "departure_time",
    "arrival.scheduledTime.local": "arrival_time",
    "departure.runwayTime/revisedTime": "actual_departure_time",
    "arrival.runwayTime/revisedTime": "actual_arrival_time",
    "departure.terminal": "departure_terminal",
    "departure.gate": "departure_gate",
    "arrival.terminal": "arrival_terminal",
    "arrival.gate": "arrival_gate",
    "departure.checkInDesk": "check_in_desk",
    "arrival.baggageBelt": "baggage_belt",
    "aircraft.model": "aircraft_model",
    "aircraft.reg": "aircraft_reg",
    "departure.airport.timeZone": "departure_timezone",
    "arrival.airport.timeZone": "arrival_timezone",
    "greatCircleDistance.km": "distance",
    "status": "status (lookup only; record status is user-set)",
    "_not_mapped_yet": ["departure.runway", "departure.checkInDesk (mapped)", "callSign", "codeshareStatus", "isCargo", "aircraft.modeS"]
  },

