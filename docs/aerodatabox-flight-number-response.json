  "field_catalog": {
    "greatCircleDistance": {
      "km": "float — route distance in kilometers",
      "mile": "float",
      "nm": "float — nautical miles",
      "meter": "float",
      "feet": "float"
    },
    "departure": {
      "airport": {
        "icao": "string — ICAO code (4-letter)",
        "iata": "string — IATA code (3-letter)",
        "name": "string — full airport name",
        "shortName": "string — short name",
        "municipalityName": "string — city",
        "location": { "lat": "float", "lon": "float" },
        "countryCode": "string — ISO 2-letter",
        "timeZone": "string — IANA tz"
      },
      "scheduledTime": { "utc": "string", "local": "string" },
      "revisedTime": { "utc": "string", "local": "string" },
      "runwayTime": { "utc": "string", "local": "string" },
      "predictedTime": { "utc": "string", "local": "string" },
      "terminal": "string",
      "gate": "string",
      "checkInDesk": "string",
      "baggageBelt": "string (arrival only)",
      "runway": "string — runway identifier",
      "quality": "string[] — data quality tags e.g. ['Basic', 'Live']"
    },
    "arrival": "same structure as departure; baggageBelt instead of checkInDesk",
    "lastUpdatedUtc": "string — last data update timestamp",
    "number": "string — formatted flight number e.g. 'CX 659'",
    "callSign": "string — ICAO callsign e.g. 'CPA659'",
    "status": "string — flight status: Arrived / Scheduled / Departed / EnRoute / Delayed / Cancelled / Diverted / Unknown",
    "codeshareStatus": "string — IsOperator / IsCodeshare / Unknown",
    "isCargo": "boolean",
    "aircraft": {
      "reg": "string — registration tail number",
      "modeS": "string — Mode S transponder hex",
      "model": "string — aircraft model e.g. 'Airbus A330-300'"
    },
    "airline": {
      "name": "string — airline name",
      "iata": "string — IATA code",
      "icao": "string — ICAO code"
    }
  },

  "time_formats": {
    "note": "Times use space separator (not T): '2026-10-09 01:45+08:00' for local, '2026-10-08 17:45Z' for UTC",
    "scheduledTime": "Planned schedule",
    "revisedTime": "Updated/estimated actual (gate time)",
    "runwayTime": "Actual runway time (takeoff/touchdown)",
    "predictedTime": "Historical prediction"
  }
}
